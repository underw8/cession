{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cession",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // run_worker_first: the dashboard HTML must pass the session gate too.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    }
  ],
  // Both cap per client prefix in each Cloudflare location, before requests reach the Hub.
  // namespace_id only has to be unique within your Cloudflare account.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "4271",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GATE_LIMITER",
      "namespace_id": "4272",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
}