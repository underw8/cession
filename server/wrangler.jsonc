{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cession",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // run_worker_first: the dashboard HTML must pass the session gate too.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
}