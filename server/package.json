{
  "name": "cession-server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_SKIP_AUTH:1",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "types": "wrangler types",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit && tsc --noEmit -p test",
    "images": "playwright install chromium && node scripts/readme-images.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_CODE": {
        "description": "A random string of at least 32 characters, e.g. `openssl rand -hex 16`. Enter it on first visit to register your passkey; keep it to recover a lost passkey."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@vitest/coverage-istanbul": "5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3"
  }
}
